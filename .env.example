# Node 24.x. npm não carrega este arquivo automaticamente.
PORT=3001
# Desenvolvimento sem DATABASE_URL usa SQLite local.
DATA_DIR=./data
# Na Vercel: cadastre os valores reais em Settings > Environment Variables.
# DATABASE_URL: conexão secreta PostgreSQL, preferencialmente pooled, fornecida pelo Neon.
# BLOB_READ_WRITE_TOKEN: criado pela integração Vercel Blob público.
# SETUP_TOKEN: chave secreta temporária, aleatória, com 32+ caracteres para /admin.
# APP_ORIGIN: origem HTTPS real, sem barra final.
# Não adicione prefixo VITE_ a credenciais e não copie valores reais para este arquivo.
# Fora da Vercel, use 1 apenas atrás de um proxy reverso confiável.
TRUST_PROXY=0
# ADMIN_EMAIL e ADMIN_PASSWORD: somente para npm run admin:create (opção via terminal).
