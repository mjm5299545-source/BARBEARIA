# Node 24+. Os comandos npm não leem este arquivo automaticamente.
# Em desenvolvimento, exporte variáveis ou use node --env-file=.env server/index.mjs.
PORT=3001
DATA_DIR=./data
# Defina para o domínio HTTPS final em produção (sem barra no final).
# APP_ORIGIN=https://seu-dominio.com.br
# Ative apenas atrás de um único proxy reverso de confiança que sobrescreve X-Forwarded-*.
TRUST_PROXY=0
# ADMIN_EMAIL e ADMIN_PASSWORD são usados SOMENTE no comando de criação de conta.
# Forneça por ambiente seguro ou pelo assistente interativo: npm run admin:setup
# Não armazene senhas neste arquivo.
